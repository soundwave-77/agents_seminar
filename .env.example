# Скопируйте этот файл в .env и заполните значения.
# Адрес и ключ API моделей возьмите из Stepik.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Сохраните модели, заданные для семинара.
AGENT_MODEL=qwen/qwen3.6-35b-a3b
SYNTHETIC_USER_MODEL=openai/gpt-6-luna
JUDGE_MODEL=openai/gpt-6-luna

# Ключи и адрес Langfuse возьмите из своего проекта в Langfuse.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
